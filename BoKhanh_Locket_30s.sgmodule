#!name=👑 Locket Gold 45s + Khung Loopy 3D (Bố Khánh)
#!desc=Thương hiệu: Bố Khánh | Đã lên Locket Gold vĩnh viễn + Khung Widget Loopy 3D đổi theo ngày 💛
#!author=Bố Khánh
#!homepage=https://github.com/KhangTestBot/ngduykhanhsiudz
#!moduleUrl=https://raw.githubusercontent.com/KhangTestBot/ngduykhanhsiudz/refs/heads/main/BoKhanh_Locket_30s.sgmodule
#!icon=https://raw.githubusercontent.com/KhangTestBot/ngduykhanhsiudz/refs/heads/main/Code_Generated_Image.png

[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP
AND,((DOMAIN-SUFFIX,googleapis.com),(PROTOCOL,UDP)),REJECT

[Header Rewrite]
^https?://api\.(revenuecat|rc-backup)\.com/.+/(receipts$|subscribers/?(.*?)*$) header-del x-revenuecat-etag
^https?://api\.(revenuecat|rc-backup)\.com/.+/(receipts$|subscribers/?(.*?)*$) header-del X-RevenueCat-ETag
^https?://api\.(revenuecat|rc-backup)\.com/.+/(receipts$|subscribers/?(.*?)*$) header-del if-none-match
^https?://api\.(revenuecat|rc-backup)\.com/.+/(receipts$|subscribers/?(.*?)*$) header-del If-None-Match
^https?://firebaseremoteconfig\.googleapis\.com/ header-del if-none-match
^https?://firebaseremoteconfig\.googleapis\.com/ header-del If-None-Match

[Script]
#LocketGold - Bố Khánh
#hostname = api.revenuecat.com, firebaseremoteconfig.googleapis.com
revenuecat = type=http-response, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/KhangTestBot/ngduykhanhsiudz/refs/heads/main/locket_vip.js?v=7, requires-body=true, max-size=-1, timeout=60
deleteHeader = type=http-request, pattern=^https:\/\/(api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers)|firebaseremoteconfig\.googleapis\.com\/), script-path=https://raw.githubusercontent.com/KhangTestBot/ngduykhanhsiudz/refs/heads/main/deleteheader.js?v=7, timeout=60
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/KhangTestBot/ngduykhanhsiudz/refs/heads/main/locket_unlocked.js?v=7, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com, api.rc-backup.com

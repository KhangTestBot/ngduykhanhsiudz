[Rule]
AND,((PROTOCOL,UDP),(DST-PORT,443)),REJECT-NO-DROP
AND,((DOMAIN,firebaseremoteconfig.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.revenuecat.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,googleapis.com),(PROTOCOL,UDP)),REJECT

[Header Rewrite]
^https?:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers) header-del x-revenuecat-etag
^https?:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers) header-del X-RevenueCat-ETag
^https?:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers) header-del if-none-match
^https?:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers) header-del If-None-Match
^https?:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers) header-del if-modified-since
^https?:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers) header-del If-Modified-Since

^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del if-none-match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del If-None-Match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del if-modified-since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del If-Modified-Since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-del x-goog-if-none-match

^https?:\/\/api\.locketcamera\.com\/.+ header-del if-none-match
^https?:\/\/api\.locketcamera\.com\/.+ header-del If-None-Match
^https?:\/\/api\.locketcamera\.com\/.+ header-del if-modified-since
^https?:\/\/api\.locketcamera\.com\/.+ header-del If-Modified-Since

[Script]
#LocketGold + Khung Loopy 3D + Photobooth Filter ✨ - Bố Khánh
deleteHeader_RC = type=http-request, pattern=^https?:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/KhangTestBot/ngduykhanhsiudz/refs/heads/main/deleteheader.js?v=6, timeout=60
deleteHeader_Firebase = type=http-request, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/KhangTestBot/ngduykhanhsiudz/refs/heads/main/deleteheader.js?v=6, timeout=60

revenuecat = type=http-response, pattern=^https?:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/KhangTestBot/ngduykhanhsiudz/refs/heads/main/locket_vip.js?v=6, requires-body=true, max-size=-1, timeout=60
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/KhangTestBot/ngduykhanhsiudz/refs/heads/main/locket_unlocked.js?v=6, requires-body=true, max-size=-1, timeout=60

locket_filter_req = type=http-request, pattern=^https:\/\/api\.locketcamera\.com\/.+, requires-body=true, max-size=-1, script-path=https://raw.githubusercontent.com/KhangTestBot/ngduykhanhsiudz/refs/heads/main/locket_filter.js?v=6, timeout=60
locket_filter_resp = type=http-response, pattern=^https:\/\/api\.locketcamera\.com\/.+, requires-body=true, max-size=-1, script-path=https://raw.githubusercontent.com/KhangTestBot/ngduykhanhsiudz/refs/heads/main/locket_filter.js?v=6, timeout=60

[MITM]
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com, api.rc-backup.com, api.locketcamera.com, *.locketcamera.com
